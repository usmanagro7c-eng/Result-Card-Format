<?xml version="1.0" encoding="utf-8"?>
<!--
    Static loading bar for the native launch window.

    The system starting window is a single pre-decoded bitmap, so it cannot
    animate. Without a bar here it showed only the lockup, and then the web #boot
    overlay appeared with a bar - two visibly different splash screens with a
    blink between them.

    Drawing the same track + navy segment in the same place as the CSS bar makes
    the two stages identical, so the launch reads as one continuous splash that
    simply starts animating once the WebView takes over. The only difference the
    eye can catch is the segment beginning to slide.

    Geometry must stay in step with .boot__bar in mobile/index.html:
        width 240dp, height 4dp, 84dp above the bottom, 2dp radius,
        track #E2E8F0 -> #F1F5F9, segment #28246A at ~45% width.
    A native drawable cannot use vw units, which is why the CSS side is a fixed
    px size rather than a percentage - so both can be pinned to the same number.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Track -->
    <item>
        <shape android:shape="rectangle">
            <size android:width="240dp" android:height="4dp" />
            <corners android:radius="2dp" />
            <gradient
                android:angle="0"
                android:type="linear"
                android:startColor="#E2E8F0"
                android:endColor="#F1F5F9" />
        </shape>
    </item>

    <!-- Segment, parked at the start; the web overlay animates it from here -->
    <item
        android:width="108dp"
        android:height="4dp"
        android:gravity="start|center_vertical">
        <shape android:shape="rectangle">
            <size android:width="108dp" android:height="4dp" />
            <corners android:radius="2dp" />
            <solid android:color="#28246A" />
        </shape>
    </item>
</layer-list>