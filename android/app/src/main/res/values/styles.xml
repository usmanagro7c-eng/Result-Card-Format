<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
    </style>


    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <!--
            The launch window shows the TCS lockup on white, never a blank white
            screen.

            On API 28 the platform builds its starting window from
            android:windowBackground, so that is what has to carry the branding -
            windowSplashScreenAnimatedIcon is an AndroidX/12+ concept and is not
            what the platform reads there. Leaving windowBackground as plain white
            produced exactly the reported flash: white first, logo afterwards.

            windowSplashScreenAnimatedIcon must resolve to a raster drawable.
            PhoneWindowManager.addSplashScreen decodes it with
            BitmapFactory.decodeResource, so pointing it at an XML layer-list
            throws Resources$NotFoundException and kills the Activity outright
            rather than falling back. Only the PNG lockup belongs in that slot.

            The loading bar lives in the web layer (#boot in mobile/index.html),
            since the starting window is a static bitmap and cannot animate.

            postSplashScreenTheme is required by Theme.SplashScreen.
        -->
        <item name="android:background">@drawable/splash_window</item>
        <item name="android:windowBackground">@drawable/splash_window</item>
        <item name="windowSplashScreenBackground">@android:color/white</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_lockup</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>